# Local development ports.
# 5001/5174 rather than the usual 5000/5173 because those are commonly taken
# by other projects on the same machine, and a silent clash is confusing:
# whichever service wins the port is the only one that appears to work.
# The frontend dev server pins 5174 via strictPort, and VITE_API_URL must
# match this PORT, or the browser gets a CORS error on every request.
# On Render, set PORT to the port assigned by the platform (usually 10000).
PORT=5001

MONGODB_URI=mongodb://127.0.0.1:27017/essa_school
MONGODB_USERNAME=
MONGODB_PASSWORD=

JWT_SECRET=replace_with_a_long_random_string

# Origin allowed by CORS and used in email links.
# Production (Render): https://essa-nyarugunga-school-complex-syst-eta.vercel.app
# Local development:   http://localhost:5174
FRONTEND_URL=https://essa-nyarugunga-school-complex-syst-eta.vercel.app

# Optional extra allowed origins, comma separated. Use this for Vercel preview
# deployments or any additional frontend host. The production URL above and the
# local dev origins are always allowed by the backend code.
FRONTEND_URLS=

# Outbound email via Resend (https://resend.com/api-keys).
# Create an API key with the "Send emails" permission.
RESEND_API_KEY=

# Sender must be verified in Resend. Format: "Name <address@your-domain>"
# Use your verified school domain in production; resend.dev test senders are
# limited to the email address on your Resend account.
EMAIL_FROM=

# Recipient for contact-form notifications.
ADMIN_EMAIL=admin@essa.rw

# Optional recipient for `node test.js`. Defaults to ADMIN_EMAIL, then EMAIL_FROM.
TEST_EMAIL=

# Upload storage. Use cloudinary in production so uploaded images and files
# survive Render restarts. Leave STORAGE_PROVIDER unset to auto-detect, or set
# local for local development.
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_UPLOAD_BYTES=10485760

# Bootstrap Headmaster credentials used only when the database has no users.
SEED_HEADMASTER_EMAIL=admin@essa.rw
SEED_HEADMASTER_PASSWORD=change_me_after_first_login
SEED_HEADMASTER_NAME=Head Master
SEED_HEADMASTER_PHONE=+250788123456

# Notifications are in-app + email only. No SMS, push or chat provider is used.
